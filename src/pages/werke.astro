---
import Base from '../layouts/Base.astro';
import { MALEREI, KERAMIK, ORBIT_CENTER, ORBIT_ITEMS, T, roman } from '../data/content.js';

// positions of the 5 orbiting artworks (from the prototype)
const ORBIT_POS = [
  'left:calc(50% - 50px);top:calc(50% - 235px)',
  'left:calc(50% + 126px);top:calc(50% - 107px)',
  'left:calc(50% + 59px);top:calc(50% + 100px)',
  'left:calc(50% - 159px);top:calc(50% + 100px)',
  'left:calc(50% - 226px);top:calc(50% - 107px)',
];
---

<Base
  title="Werke — DOBOJO · Malerei, Keramik & Skulpturen"
  description="Werke von Doris Boschung-Johner: abstrakte Malerei in Acryl, Öl und Bleistift sowie Keramik und Skulpturen aus Ton, Porzellan und Steinzeug."
  active="werke"
>
  <div class="werke-wrap">
    <section class="werke-hero" data-werke-hero>
      <div class="tree-scene" data-tree-scene aria-hidden="true">
        <svg class="tree" data-tree width="280" height="360" viewBox="0 0 280 360" fill="none">
          <ellipse cx="140" cy="354" rx="66" ry="7" fill="rgba(22,20,15,.4)"></ellipse>
          <path d="M130 356 L136 260 C136 230 128 210 132 180 L148 180 C152 210 146 230 148 260 L156 356 Z" fill="#16140f"></path>
          <path d="M134 230 C110 214 100 200 96 186 L106 182 C118 198 128 210 138 218 Z" fill="#16140f"></path>
          <path d="M146 210 C170 196 180 184 184 168 L174 164 C162 180 152 192 144 200 Z" fill="#16140f"></path>
          <circle cx="140" cy="110" r="78" fill="#16140f"></circle>
          <circle cx="76" cy="150" r="48" fill="#16140f"></circle>
          <circle cx="204" cy="146" r="48" fill="#16140f"></circle>
          <circle cx="104" cy="92" r="6" fill="#35A9CC"></circle>
          <circle cx="176" cy="76" r="6" fill="#35A9CC"></circle>
          <circle cx="150" cy="138" r="6" fill="#35A9CC"></circle>
          <circle cx="70" cy="160" r="5" fill="#35A9CC"></circle>
          <circle cx="212" cy="162" r="5" fill="#35A9CC"></circle>
        </svg>
        {[
          'left:96px;top:78px',
          'left:146px;top:46px',
          'left:174px;top:96px',
          'left:58px;top:140px',
          'left:188px;top:142px',
        ].map((pos) => (
          <svg data-tree-bird width="26" height="14" viewBox="0 0 26 14" fill="none" style={pos}>
            <path d="M1 11 Q7 1 13 11" stroke="#FAF6EC" stroke-width="2.5" stroke-linecap="round"></path>
            <path d="M13 11 Q19 1 25 11" stroke="#FAF6EC" stroke-width="2.5" stroke-linecap="round"></path>
          </svg>
        ))}
      </div>
      <svg class="cat" data-cat width="150" height="86" viewBox="0 0 150 86" fill="none" aria-hidden="true">
        <ellipse cx="75" cy="82" rx="52" ry="4.5" fill="rgba(22,20,15,.4)"></ellipse>
        <path d="M128 52 C144 44 148 28 140 16 C138 26 132 34 122 40 Z" fill="#16140f"></path>
        <ellipse cx="78" cy="56" rx="46" ry="20" fill="#16140f"></ellipse>
        <rect x="46" y="66" width="9" height="16" rx="4" fill="#16140f"></rect>
        <rect x="66" y="68" width="9" height="14" rx="4" fill="#16140f"></rect>
        <rect x="90" y="68" width="9" height="14" rx="4" fill="#16140f"></rect>
        <rect x="106" y="66" width="9" height="16" rx="4" fill="#16140f"></rect>
        <circle cx="28" cy="34" r="17" fill="#16140f"></circle>
        <path d="M14 24 L10 4 L26 16 Z" fill="#16140f"></path>
        <path d="M34 15 L44 0 L46 20 Z" fill="#16140f"></path>
        <circle cx="21" cy="31" r="2.4" fill="#35A9CC"></circle>
        <circle cx="33" cy="31" r="2.4" fill="#35A9CC"></circle>
      </svg>

      <h1 class="page-title" data-hero-fade data-reveal data-i18n="werkeH">{T.werkeH}</h1>
      <div class="bluebar" data-hero-fade data-reveal style="margin:28px 0 0"></div>

      <div class="orbit-wrap" data-orbit-wrap data-reveal>
        <div class="orbit-scale">
          <img class="orbit-center" src={ORBIT_CENTER} alt="" width="180" height="180" />
          <div class="orbit" data-orbit>
            {ORBIT_ITEMS.map((src, i) => (
              <span class="orbit-item" data-orbit-item style={ORBIT_POS[i]}>
                <img src={src} alt="" width="100" height="100" />
              </span>
            ))}
          </div>
        </div>
      </div>

      <p class="werke-intro" data-hero-fade data-reveal data-i18n="wIntro">{T.wIntro}</p>
      <div class="jump-chips" data-hero-fade data-reveal>
        <a class="jump-chip" href="#sec-malerei" data-scroll-to="sec-malerei"><span data-i18n="c1Title">{T.c1Title}</span> <span>→</span></a>
        <a class="jump-chip" href="#sec-keramik" data-scroll-to="sec-keramik"><span data-i18n="c2Title">{T.c2Title}</span> <span>→</span></a>
      </div>
    </section>

    <section class="gallery-section" id="sec-malerei">
      <div class="gallery-head" data-reveal>
        <span class="g-title" data-i18n="c1Title">{T.c1Title}</span>
        <span class="g-label" data-i18n="c1Label">{T.c1Label}</span>
      </div>
      <div class="gallery-grid">
        {MALEREI.map((w, i) => (
          <div data-reveal>
            <button class="art-open" type="button" data-full={w.image} aria-label={`${w.title || `${T.untitled} ${roman(i)}`} vergrössern`}>
              <div class="art-tile" data-art role="img" aria-label={w.title || `${T.untitled} ${roman(i)}`} style={`background-image:url('${w.image}')`}></div>
            </button>
            <div class="art-caption">
              {w.title
                ? <span class="t">{w.title}</span>
                : <span class="t"><span data-i18n="untitled">{T.untitled}</span> {roman(i)}</span>}
              {w.medium
                ? <span class="m">{w.medium}</span>
                : <span class="m" data-i18n="medP">{T.medP}</span>}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="gallery-section last" id="sec-keramik">
      <div class="gallery-head" data-reveal>
        <span class="g-title" data-i18n="c2Title">{T.c2Title}</span>
        <span class="g-label" data-i18n="c2Label">{T.c2Label}</span>
      </div>
      <div class="gallery-grid">
        {KERAMIK.map((w, i) => (
          <div data-reveal>
            <button class="art-open" type="button" data-full={w.image} aria-label={`${w.title || `${T.untitled} ${roman(i)}`} vergrössern`}>
              <div class="art-tile" data-art role="img" aria-label={w.title || `${T.untitled} ${roman(i)}`} style={`background-image:url('${w.image}')`}></div>
            </button>
            <div class="art-caption">
              {w.title
                ? <span class="t">{w.title}</span>
                : <span class="t"><span data-i18n="untitled">{T.untitled}</span> {roman(i)}</span>}
              {w.medium
                ? <span class="m">{w.medium}</span>
                : <span class="m" data-i18n="medC">{T.medC}</span>}
            </div>
          </div>
        ))}
      </div>
    </section>

    <dialog class="lightbox" data-lightbox>
      <button class="lb-close" type="button" aria-label="Schliessen">×</button>
      <button class="lb-prev" type="button" aria-label="Vorheriges Werk">←</button>
      <figure class="lb-figure">
        <img class="lb-img" alt="" />
        <figcaption class="lb-cap"></figcaption>
      </figure>
      <button class="lb-next" type="button" aria-label="Nächstes Werk">→</button>
      <span class="lb-counter"></span>
    </dialog>
  </div>

  <script>
    // Fullscreen lightbox for the artwork tiles — same native-dialog pattern
    // as the Casa d'Italia gallery (display gated to [open], wrap-around nav).
    const lb = document.querySelector('[data-lightbox]') as HTMLDialogElement | null;
    if (lb) {
      const img = lb.querySelector('.lb-img') as HTMLImageElement;
      const cap = lb.querySelector('.lb-cap') as HTMLElement;
      const counter = lb.querySelector('.lb-counter') as HTMLElement;
      const openers = [...document.querySelectorAll<HTMLButtonElement>('.art-open')];
      let idx = 0;

      const show = (i: number) => {
        idx = (i + openers.length) % openers.length;
        const btn = openers[idx];
        img.src = btn.dataset.full || '';
        // caption from the tile's caption row — follows the active language
        const capRow = btn.parentElement?.querySelector('.art-caption');
        const t = capRow?.querySelector('.t')?.textContent?.trim() || '';
        const m = capRow?.querySelector('.m')?.textContent?.trim() || '';
        cap.textContent = m ? `${t} — ${m}` : t;
        img.alt = t;
        counter.textContent = `${idx + 1} / ${openers.length}`;
      };

      openers.forEach((btn, i) => btn.addEventListener('click', () => { show(i); lb.showModal(); }));
      lb.querySelector('.lb-close')?.addEventListener('click', () => lb.close());
      lb.querySelector('.lb-prev')?.addEventListener('click', () => show(idx - 1));
      lb.querySelector('.lb-next')?.addEventListener('click', () => show(idx + 1));
      lb.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') show(idx - 1);
        if (e.key === 'ArrowRight') show(idx + 1);
      });
      lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
    }
  </script>
</Base>
